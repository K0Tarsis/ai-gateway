# Copy to .env and fill in values. These are substituted into config.yaml
# wherever a ${VAR_NAME} placeholder appears.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Log level (read by tracing_subscriber::EnvFilter), e.g. info, debug, trace,
# or per-module like ai_gateway=debug,tower_http=info
RUST_LOG=info
