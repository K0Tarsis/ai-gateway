{
  "info": {
    "_postman_id": "5f6d6b1a-3c2e-4d8a-9f1a-1f2a3b4c5d6e",
    "name": "AI Gateway",
    "description": "Test flow for the AI Gateway (OpenAI-compatible proxy). Matches the routes actually registered in src/main.rs: POST /v1/chat/completions, GET /v1/models, GET /v1/usage, GET /metrics. Run folders top-to-bottom with the Collection Runner, or step through manually.\n\nBefore running:\n1. Start the gateway (`cargo run`) with your local `config.yaml` and provider API keys set.\n2. Set `apiKeyDesktop` / `apiKeyPartnerA` to the `api_keys` entries under each profile in your `config.yaml`.\n3. Set `model` to a model your enabled provider actually serves (e.g. `gpt-4o-mini` for OpenAI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" },
    { "key": "apiKeyDesktop", "value": "key_for_request" },
    { "key": "apiKeyPartnerA", "value": "key_for_partner_a" },
    { "key": "model", "value": "gpt-4o-mini" },
    { "key": "anthropicModel", "value": "claude-sonnet-4-20250514" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "No Authorization header -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('error body shape', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.error.message).to.include('Authorization');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed Authorization header -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Token not-a-bearer-token" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid API key -> 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer gw_totally_invalid_key" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('message says invalid key', () => {",
                  "    pm.expect(pm.response.json().error.message).to.include('Invalid API key');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Valid desktop key -> 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has x-request-id header', () => {",
                  "    pm.expect(pm.response.headers.has('x-request-id')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Models & Usage",
      "item": [
        {
          "name": "List providers (desktop profile)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('object is list', () => pm.expect(body.object).to.eql('list'));",
                  "pm.test('data only contains profile fallback entries', () => {",
                  "    pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "    body.data.forEach(p => {",
                  "        pm.expect(p).to.have.all.keys('id', 'object', 'owned_by', 'healthy');",
                  "    });",
                  "});",
                  "if (body.data.length) {",
                  "    pm.collectionVariables.set('firstProviderId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List providers (partner-a profile)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyPartnerA}}" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('partner-a sees a different fallback set than desktop', () => {",
                  "    const ids = pm.response.json().data.map(p => p.id);",
                  "    pm.expect(ids).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Usage (desktop profile)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" }],
            "url": { "raw": "{{baseUrl}}/v1/usage", "host": ["{{baseUrl}}"], "path": ["v1", "usage"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('usage shape', () => {",
                  "    pm.expect(body).to.have.all.keys('profile', 'today', 'month_to_date');",
                  "    pm.expect(body.profile).to.eql('desktop');",
                  "    pm.expect(body.today).to.be.an('array');",
                  "    pm.expect(body.month_to_date).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Usage is scoped per-profile (partner-a sees its own only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyPartnerA}}" }],
            "url": { "raw": "{{baseUrl}}/v1/usage", "host": ["{{baseUrl}}"], "path": ["v1", "usage"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('profile field matches caller, not desktop', () => {",
                  "    pm.expect(pm.response.json().profile).to.eql('partner-a');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Chat Completions",
      "item": [
        {
          "name": "Basic chat completion (non-streaming)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Reply with the single word: pong\" }\n  ],\n  \"temperature\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('OpenAI-shaped chat response', () => {",
                  "    pm.expect(body).to.include.keys('id', 'object', 'created', 'model', 'choices');",
                  "    pm.expect(body.choices[0].message.content).to.be.a('string').that.is.not.empty;",
                  "});",
                  "if (body.usage) {",
                  "    pm.test('usage tokens are non-negative', () => {",
                  "        pm.expect(body.usage.prompt_tokens).to.be.at.least(0);",
                  "        pm.expect(body.usage.completion_tokens).to.be.at.least(0);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing required field (no messages) -> 4xx",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected as client error (axum Json extractor rejection, not a GatewayError)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON body -> 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ this is not valid json"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Streaming chat completion (SSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"stream\": true,\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Count from 1 to 3.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('content-type is event-stream', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "pm.test('stream ends with [DONE] sentinel', () => {",
                  "    pm.expect(pm.response.text()).to.include('data: [DONE]');",
                  "});",
                  "",
                  "// Note: Postman buffers the whole SSE body before running tests,",
                  "// so this validates final content rather than live incremental delivery.",
                  "// Use Postman's 'Send and Download' / raw view to watch chunks arrive."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Provider Routing & Multi-Tenancy",
      "item": [
        {
          "name": "Pin to allowed provider (desktop -> openai)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"provider\": \"openai\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hi in one word.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (openai is in desktop\\'s fallback list)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pin to disallowed provider (desktop -> anthropic) -> 404",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"provider\": \"anthropic\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hi.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// desktop's routing.fallback is [openai] only, so pinning to anthropic",
                  "// (not in that allowlist) must be rejected, per routing::build_order.",
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('message explains why', () => {",
                  "    pm.expect(pm.response.json().error.message).to.include('not permitted for this profile');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Pin to allowed route (partner-a -> anthropic-sonnet)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyPartnerA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"this-value-is-ignored-because-a-route-is-pinned\",\n  \"provider\": \"anthropic-sonnet\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hi in one word.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// partner-a's fallback is now [anthropic-sonnet, openai-gpt4o-mini] -- both",
                  "// routes, not bare provider names, since a fallback spanning multiple",
                  "// vendors must name only routes (see config::validate). A route always",
                  "// overwrites `model` server-side (RoutedProvider::chat), so the deliberately",
                  "// bogus model string in this request body is expected to be ignored.",
                  "pm.test('status is 200 (anthropic-sonnet is in partner-a\\'s fallback list)', () => pm.response.to.have.status(200));",
                  "pm.test('response model is the route\\'s pinned model, not the client-sent one', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.model).to.not.eql('this-value-is-ignored-because-a-route-is-pinned');",
                  "    pm.expect(body.model).to.include('claude');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Pin to disallowed bare provider (partner-a -> anthropic) -> 404",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyPartnerA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{anthropicModel}}\",\n  \"provider\": \"anthropic\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hi.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// partner-a's fallback now names the route 'anthropic-sonnet', not the",
                  "// bare provider 'anthropic' -- so pinning the bare name is rejected exactly",
                  "// like pinning anything else outside the profile's allowlist.",
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('message explains why', () => {",
                  "    pm.expect(pm.response.json().error.message).to.include('not permitted for this profile');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown model/provider fallback exhausted -> error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"provider\": \"does-not-exist\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Say hi.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404 (provider name not in profile allowlist)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Rate & Cost Limits (opt-in, requires config)",
      "item": [
        {
          "name": "README - how to exercise these",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" }],
            "url": { "raw": "{{baseUrl}}/v1/models", "host": ["{{baseUrl}}"], "path": ["v1", "models"] },
            "description": "These two limits are opt-in per profile in config.yaml and are NOT set on the desktop/partner-a profiles by default, so there is nothing to trigger out of the box.\n\nTo test rate_limit:\n1. Add to a profile in config.yaml:\n   rate_limit:\n     requests_per_minute: 3\n2. Restart the gateway.\n3. Select 'Trigger rate limit' below and run it via Collection Runner with 5+ iterations, 0ms delay. The requests past the limit should return 429 with a GatewayError::RateLimited body.\n\nTo test cost_limit:\n1. Add pricing: entry for your model AND a cost_limit (daily_usd/monthly_usd) to the profile.\n2. Send enough real chat completions to cross the cap (check GET /v1/usage to watch spend accumulate).\n3. The next chat completion should return 429 with a GatewayError::CostLimitExceeded body -- this only gates POST /v1/chat/completions, not /v1/models or /v1/usage."
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('reachable', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Trigger rate limit (run via Collection Runner, 5+ iterations)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"ping\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["v1", "chat", "completions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only meaningful once rate_limit.requests_per_minute is set for this profile.",
                  "pm.test('status is 200 or 429', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
                  "});",
                  "if (pm.response.code === 429) {",
                  "    pm.test('429 body names the profile and its cap', () => {",
                  "        pm.expect(pm.response.json().error.message).to.include('exceeded');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Observability",
      "item": [
        {
          "name": "Metrics endpoint (run after the folders above)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{apiKeyDesktop}}" }],
            "url": { "raw": "{{baseUrl}}/metrics", "host": ["{{baseUrl}}"], "path": ["metrics"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('prometheus content-type', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "});",
                  "pm.test('exposes gateway_requests_total after earlier requests in this run', () => {",
                  "    pm.expect(pm.response.text()).to.include('http_requests_total');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
